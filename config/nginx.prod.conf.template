events {
    worker_connections 1024;
}

http {
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Services such as the BFF call each other through this proxy, so an incoming ID in the format nginx
    # generates is kept and both hops share it. Anything else is replaced with a new ID.
    map $http_x_request_id $req_id {
        "~^[0-9a-f]{32}$" $http_x_request_id;
        default $request_id;
    }

    log_format access escape=json '{'
        '"time":"$time_iso8601",'
        '"request_id":"$req_id",'
        '"remote_addr":"$remote_addr",'
        '"host":"$host",'
        '"method":"$request_method",'
        '"uri":"$request_uri",'
        '"status":$status,'
        '"body_bytes_sent":$body_bytes_sent,'
        '"request_time":$request_time,'
        '"upstream":"$proxy_host",'
        '"upstream_status":"$upstream_status",'
        '"upstream_response_time":"$upstream_response_time",'
        '"referer":"$http_referer",'
        '"user_agent":"$http_user_agent"'
    '}';

    access_log /dev/stdout access;

    server {
        listen 80;
        server_name ${DOMAIN_NAME};

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl;
        server_name ${DOMAIN_NAME};

        ssl_certificate /run/secrets/server_crt;
        ssl_certificate_key /run/secrets/server_key;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;
        ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';

        # After the first visit, browsers use HTTPS for the domain for a year, even for an http:// link. Not with
        # includeSubDomains: other subdomains of the domain may not be served over HTTPS.
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer-when-downgrade" always;

        location / {
            set $core http://identity-link-core:9000;
            proxy_pass $core;

            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Request-Id $req_id;
        }

        # OpenID Connect Discovery 1.0 puts the discovery document at <issuer>/.well-known/openid-configuration, and
        # libraries that find the provider from its issuer request it there. The issuer (JWT_URL in docker-compose.yml)
        # has a path, e.g. https://${DOMAIN_NAME}/identity-link, but core serves the document only at the root, so
        # this serves the same document under the issuer too. ISSUER_PATH comes from JWT_URL.
        location = ${ISSUER_PATH}/.well-known/openid-configuration {
            set $core http://identity-link-core:9000;
            rewrite ^ /.well-known/openid-configuration break;
            proxy_pass $core;

            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Request-Id $req_id;
        }

        location /users/ {
            set $users http://identity-link-db-users:9001;
            rewrite ^/users(/.*)$ $1 break;
            proxy_pass $users;

            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Request-Id $req_id;
            proxy_set_header X-Forwarded-Prefix /users;
        }

        location /clients/ {
            set $clients http://identity-link-db-clients:9002;
            rewrite ^/clients(/.*)$ $1 break;
            proxy_pass $clients;

            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Request-Id $req_id;
            proxy_set_header X-Forwarded-Prefix /clients;
        }

        location /2fa/ {
            set $twofa http://identity-link-2fa:9003;
            rewrite ^/2fa(/.*)$ $1 break;
            proxy_pass $twofa;

            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Request-Id $req_id;
            proxy_set_header X-Forwarded-Prefix /2fa;
        }

        location = /admin-console {
            return 301 /admin-console/;
        }

        location /admin-console/ {
            set $console http://identity-link-console:9005;
            proxy_pass $console;

            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Request-Id $req_id;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }

        location /bff/ {
            set $bff http://identity-link-bff:9004;
            rewrite ^/bff(/.*)$ $1 break;
            proxy_pass $bff;

            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Request-Id $req_id;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Prefix /bff;
        }
    }
}